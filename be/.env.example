APP_NAME=Sunsight
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: PostgreSQL 16 + PostGIS.
# Ekstensi PostGIS wajib aktif. Lihat README.md untuk langkah CREATE EXTENSION.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sunsight
DB_USERNAME=sunsight
DB_PASSWORD=sunsight

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Penyedia citra satelit.
# `mapbox` memakai Mapbox Static Images dan memerlukan MAPBOX_ACCESS_TOKEN.
# `sample` memakai fixture lokal sintetis sehingga alur dapat dijalankan tanpa jaringan.
# ToS Mapbox mengizinkan penggunaan non-produksi (pengembangan, pengujian, dan
# demonstrasi) dengan atribusi tampil; penggunaan produksi untuk aplikasi yang
# berkaitan dengan real estate atau analytics memerlukan lisensi komersial.
IMAGERY_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE=satellite-v9
MAPBOX_IMAGE_SIZE=1280

# Layanan model segmentasi bidang atap. Endpoint yang dipanggil adalah
# POST {ML_SERVICE_URL}/api/v1/predict dengan citra multipart.
# Inferensi berjalan di CPU: sekitar 11-13 detik untuk permintaan pertama setelah
# layanan dinyalakan (pemanasan model) dan 3-8 detik berikutnya untuk citra 1280 px.
# Batas waktunya 60 detik supaya mesin yang lebih lambat tidak dianggap gagal;
# 504 baru dijawab setelah batas ini.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT=60

# Rugi sistem (suhu, kabel, kotoran) dan emisi jaringan PLN untuk model produksi studio.
PLTS_SYSTEM_LOSS_RATIO=0.82
PLTS_CO2_KG_PER_KWH=0.80

VITE_APP_NAME="${APP_NAME}"
