// URL API backend. Nilai bawaan menunjuk ke server pengembangan Laravel.
// Salin berkas ini menjadi .env.local bila alamatnya berbeda.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

// Mode mock hanya untuk mencoba antarmuka tanpa backend. Biarkan `false` untuk
// build dan deploy; nilai `true` membuat seluruh permintaan dijawab data contoh.
NEXT_PUBLIC_USE_MOCK=false
