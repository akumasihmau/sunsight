# Salin menjadi .env saat menjalankan FastAPI ML Service secara lokal
MODEL_PATH=weights/best.onnx
MODEL_NAME=yolo11s-seg
MODEL_VERSION=v2-esri-bogor
MODEL_IMAGE_SIZE=1280
MODEL_CONFIDENCE=0.25
MODEL_IOU_THRESHOLD=0.45
USE_CLAHE_LAB=false

# Post-Processing Anti-Blobby & Anti-Jalan
MIN_CONTOUR_AREA_PX=140.0
MAX_ASPECT_RATIO=7.5
RECTANGULARITY_SNAP_THRESHOLD=0.80
ORTHOGONAL_MIN_RECTANGULARITY=0.55
APPROX_EPSILON_RATIO=0.015

# Keamanan & Batas Request
API_V1_PREFIX=/api/v1
API_KEY=
MAX_IMAGE_SIZE=10485760
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_INFERENCES=1
LOG_LEVEL=INFO
